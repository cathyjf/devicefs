<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="devicefs" Description="Code-analysis rules enforced by devicefs." ToolsVersion="10.0">
  <Include Path="NativeRecommendedRules.ruleset" Action="Error" />
  <Include Path="CppCoreCheckRules.ruleset" Action="Error" />
  <Rules AnalyzerId="Microsoft.Analyzers.NativeCodeAnalysis" RuleNamespace="Microsoft.Rules.Native">
    <!-- "Prefer to use gsl::at() instead of unchecked subscript operator." -->
    <Rule Id="C26446" Action="None" />
    <!-- "Don't use pointer arithmetic. Use span instead." -->
    <Rule Id="C26481" Action="None" />
    <!-- "Expression 'expr': No array to pointer decay." -->
    <Rule Id="C26485" Action="None" />
  </Rules>
</RuleSet>
