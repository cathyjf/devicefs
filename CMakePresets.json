{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/refs/tags/v4.4.3/Help/manual/presets/schema.json",
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_VS_GLOBALS": "ForceImportAfterCppDefaultProps=${sourceDir}/misc/ApplyMsvcOverrides.props"
      },
      "environment": {
        "POWERSHELL_TELEMETRY_OPTOUT": "true",
        "POWERSHELL_UPDATECHECK": "Off",
        "POWERSHELL_DIAGNOSTICS_OPTOUT": "true",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "true",
        "VSTEL_OPT_OUT": "1",
        "VSCMD_SKIP_SENDTELEMETRY": "1"
      },
      "warnings": {
        "uninitialized": true
      },
      "errors": {
        "dev": true
      }
    },
    {
      "name": "windows-x64-instrumented",
      "inherits": "windows-x64",
      "cacheVariables": {
        "DEVICEFS_MEASURE_READ_PATH": true
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "windows-x64",
      "architecture": "arm64"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "nativeToolOptions": ["/m"]
    },
    {
      "name": "windows-x64-instrumented-release",
      "configurePreset": "windows-x64-instrumented",
      "inherits": "windows-x64-release"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "inherits": "windows-x64-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "inherits": "windows-x64-privileged",
      "filter": {
        "exclude": {
          "label": "^privileged$"
        }
      }
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "inherits": "windows-x64"
    },
    {
      "name": "windows-x64-privileged",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "execution": {
        "jobs": 0
      },
      "output": {
        "verbosity": "verbose"
      }
    },
    {
      "name": "windows-arm64-privileged",
      "configurePreset": "windows-arm64",
      "inherits": "windows-x64-privileged"
    }
  ]
}
