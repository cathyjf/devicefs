{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "DEVICEFS_MEASURE_FREE_CLUSTER_DATA": false,
        "DEVICEFS_MEASURE_READ_PATH": false
      }
    },
    {
      "name": "windows-x64-instrumented",
      "displayName": "Windows x64 — instrumented",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-instrumented",
      "cacheVariables": {
        "DEVICEFS_MEASURE_FREE_CLUSTER_DATA": false,
        "DEVICEFS_MEASURE_READ_PATH": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-instrumented-release",
      "configurePreset": "windows-x64-instrumented",
      "configuration": "Release"
    }
  ]
}
