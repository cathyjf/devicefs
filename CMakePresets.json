{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/refs/tags/v4.4.3/Help/manual/presets/schema.json",
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "POWERSHELL_TELEMETRY_OPTOUT": "true",
        "POWERSHELL_UPDATECHECK": "Off",
        "POWERSHELL_DIAGNOSTICS_OPTOUT": "true"
      },
      "warnings": {
        "uninitialized": true
      },
      "errors": {
        "dev": true
      }
    },
    {
      "name": "windows-x64-instrumented",
      "inherits": "windows-x64",
      "cacheVariables": {
        "DEVICEFS_MEASURE_READ_PATH": true
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "windows-x64",
      "architecture": "arm64"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "nativeToolOptions": ["/m"]
    },
    {
      "name": "windows-x64-instrumented-release",
      "configurePreset": "windows-x64-instrumented",
      "inherits": "windows-x64-release"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "inherits": "windows-x64-release"
    }
  ]
}
