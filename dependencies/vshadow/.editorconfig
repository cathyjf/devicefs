# Keep the vendored source close to Microsoft's VShadow sample instead of
# applying the project's formatting style.

[*.{cpp,h}]
end_of_line = crlf
trim_trailing_whitespace = false

cpp_indent_case_contents_when_block = unset
cpp_indent_case_labels = unset
cpp_indent_namespace_contents = unset
cpp_indent_preprocessor = unset
cpp_new_line_before_open_brace_namespace = unset
cpp_new_line_before_open_brace_type = new_line
cpp_new_line_before_open_brace_function = new_line
cpp_new_line_before_open_brace_block = unset
cpp_new_line_before_open_brace_lambda = unset
cpp_new_line_before_catch = true
cpp_new_line_before_else = unset
cpp_new_line_before_while_in_do_while = true

cpp_space_before_function_open_parenthesis = unset
cpp_space_within_parameter_list_parentheses = unset
cpp_space_between_empty_parameter_list_parentheses = unset
cpp_space_after_keywords_in_control_flow_statements = unset
cpp_space_within_control_flow_statement_parentheses = unset
cpp_space_before_comma = unset
cpp_space_after_comma = unset
cpp_space_around_binary_operator = unset
cpp_space_around_assignment_operator = unset
cpp_space_preserve_in_initializer_list = true
cpp_space_pointer_reference_alignment = ignore
cpp_space_around_ternary_operator = ignore
cpp_wrap_preserve_blocks = one_liners
