<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Select the preview toolchain if it is installed.
    Otherwise, use the normal toolchain.
    See <https://learn.microsoft.com/en-us/cpp/overview/acquire-msvc#use-an-installed-msvc-toolset>.
  -->
  <PropertyGroup>
    <MSVCPreviewEnabled
      Condition="Exists('$(VSInstallRoot)\VC\Auxiliary\Build\Microsoft.VCToolsVersion.Preview.props')">true</MSVCPreviewEnabled>
  </PropertyGroup>
  <!--
    Release builds use /Ob3 for more aggressive inlining.
    This runs after CMake's settings have been read so that they cannot restore /Ob2.
    MSBuild cannot select /Ob3 through InlineFunctionExpansion, so we clear that
    setting and add /Ob3 to AdditionalOptions.
    See <https://learn.microsoft.com/en-us/cpp/build/reference/ob-inline-function-expansion>.
  -->
  <Target Name="DeviceFsInlining" BeforeTargets="PrepareForBuild"
    Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ClCompile>
        <InlineFunctionExpansion>Default</InlineFunctionExpansion>
        <AdditionalOptions>%(AdditionalOptions) /Ob3</AdditionalOptions>
      </ClCompile>
    </ItemGroup>
  </Target>
  <!--
    `CMakeLists.txt` sets the custom `DeviceFsCommonProject` property on each
    executable that links the common library. The property's value is the full
    path to the generated `devicefs-common.vcxproj` file. The condition below
    limits this action to those executables.

    Executables link `devicefs-common.lib` by pathname so that their compilation
    can proceed while the library is being built. Before linking, this action
    asks MSBuild to finish building the library. The `MSBuild` task shares the
    current build's results, so a library that has already finished is reused.
    Specifying the same configuration and platform lets concurrent callers
    share the same library build.
    https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-task
  -->
  <Target Name="DeviceFsBuildCommonBeforeLink" BeforeTargets="Link"
    Condition="'$(DeviceFsCommonProject)' != ''">
    <MSBuild Projects="$(DeviceFsCommonProject)" Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)"
      BuildInParallel="$(BuildInParallel)" />
  </Target>
</Project>
