#pragma code_page(65001)

#include <winver.h>
#include "@DEVICEFS_PRODUCT_VERSION_HEADER@"

// Windows requires the version-information resource to have identifier 1.
// https://learn.microsoft.com/en-us/windows/win32/menurc/versioninfo-resource#parameters
1 VERSIONINFO

// Each numeric version consists of four 16-bit components. FILEVERSION identifies
// this executable; PRODUCTVERSION identifies the DeviceFs release it belongs to.
// The textual ProductVersion below also carries the Git revision when available.
// https://learn.microsoft.com/en-us/windows/win32/menurc/versioninfo-resource#parameters
FILEVERSION @file_version_numbers@
PRODUCTVERSION @product_version_numbers@

// FILEFLAGSMASK identifies the defined attribute bits that readers may interpret.
// VS_FFI_FILEFLAGSMASK includes all the version attributes defined by the SDK.
// FILEFLAGS selects the attributes that apply to this file: our Debug builds set
// VS_FF_DEBUG, and our other configurations set no attribute bits.
// https://learn.microsoft.com/en-us/windows/win32/menurc/versioninfo-resource#remarks
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS @debug_flag@

// These fields classify the file as a Windows NT application. The application
// file type has no subtype, so FILESUBTYPE is zero.
// https://learn.microsoft.com/en-us/windows/win32/api/verrsrc/ns-verrsrc-vs_fixedfileinfo#members
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    // StringFileInfo holds the human-readable metadata, grouped by language and
    // character set. Its named values are documented here:
    // https://learn.microsoft.com/en-us/windows/win32/menurc/stringfileinfo-block
    BLOCK "StringFileInfo"
    BEGIN
        // The table name concatenates two four-digit hexadecimal identifiers:
        // 0409 is U.S. English; fde9 is 65001, the UTF-8 code page identifier.
        // The Translation entry below advertises this same pair to readers.
        // https://learn.microsoft.com/en-us/windows/win32/menurc/stringfileinfo-block#parameters
        BLOCK "0409fde9"
        BEGIN
            VALUE "CompanyName", "Cathy J. Fitzpatrick"
            VALUE "FileDescription", "@description@"
            VALUE "FileVersion", "@file_version@"
            // InternalName identifies the build target. OriginalFilename records
            // its output filename, including the extension, even if later renamed.
            // https://learn.microsoft.com/en-us/windows/win32/menurc/versioninfo-resource#remarks
            VALUE "InternalName", "@target@"
            VALUE "OriginalFilename", "@filename@"
            VALUE "LegalCopyright", "Copyright 2026 Cathy J. Fitzpatrick"
            VALUE "ProductName", "DeviceFs"
            VALUE "ProductVersion", DEVICEFS_PRODUCT_VERSION_TEXT
        END
    END
    // Translation lists the pairs of language and character set identifiers available
    // in StringFileInfo.
    // VerQueryValue callers use these pairs to construct a path to a string table.
    // Our sole pair selects the "0409fde9" table: U.S. English (0x0409) and UTF-8
    // (65001). These numbers describe the resource strings, not this source file.
    // https://learn.microsoft.com/en-us/windows/win32/menurc/varfileinfo-block
    // https://learn.microsoft.com/en-us/windows/win32/api/winver/nf-winver-verqueryvaluew#parameters
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 65001
    END
END
