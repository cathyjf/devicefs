{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/refs/tags/v4.4.3/Help/manual/presets/schema.json",
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-configure-preset",
      "hidden": true,
      "binaryDir": "${sourceDir}/../../build/terminal/${presetName}",
      "cacheVariables": {
        "DEVICEFS_TERMINAL_BUILD_TESTS": true
      },
      "environment": {
        "POWERSHELL_TELEMETRY_OPTOUT": "true",
        "POWERSHELL_UPDATECHECK": "Off",
        "POWERSHELL_DIAGNOSTICS_OPTOUT": "true"
      },
      "warnings": {
        "uninitialized": true
      }
    },
    {
      "name": "windows-x64",
      "inherits": "base-configure-preset",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "errors": {
        "dev": true
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "windows-x64",
      "architecture": "arm64"
    },
    {
      "name": "unix",
      "inherits": "base-configure-preset",
      "generator": "Ninja Multi-Config",
      "toolchainFile": "${sourceDir}/../unix/cmake/llvm.cmake",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": false,
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++ -Wno-reserved-module-identifier",
        "CMAKE_CXX_MODULE_STD": true,
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "f35a9ac6-8463-4d38-8eec-5d6008153e7d"
      },
      "warnings": {
        "dev": false
      }
    },
    {
      "name": "unix-gcc",
      "inherits": "unix",
      "toolchainFile": "${sourceDir}/../unix/cmake/gcc.cmake",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_INIT": "-static-libstdc++ -static-libgcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "nativeToolOptions": ["/m"]
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "inherits": "windows-x64-release"
    },
    {
      "name": "unix",
      "configurePreset": "unix",
      "configuration": "Release"
    },
    {
      "name": "unix-gcc",
      "configurePreset": "unix-gcc",
      "inherits": "unix"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "verbosity": "verbose"
      }
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "inherits": "windows-x64"
    },
    {
      "name": "unix",
      "configurePreset": "unix",
      "inherits": "windows-x64"
    },
    {
      "name": "unix-gcc",
      "configurePreset": "unix-gcc",
      "inherits": "unix"
    }
  ]
}
